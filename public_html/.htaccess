# APEskansa - Basic Security
Options -Indexes

# Halaman publik yang boleh diakses langsung
<FilesMatch ".(php|inc)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
<FilesMatch "^(index|login|register|produk|detail-produk|penjual).php$">
    Allow from all
</FilesMatch>

# Folder process hanya untuk POST (kecuali file tertentu)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !/process/logout.php$ [NC]
    RewriteCond %{REQUEST_URI} !/process/update-status-pesanan.php$ [NC]
    RewriteRule ^process/ - [F]
</IfModule>

# Akses dashboard
<FilesMatch "^(dashboard/.*).php$">
    Allow from all
</FilesMatch>
