Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Hanya izinkan POST, kecuali logout dan update-status-pesanan (GET diizinkan)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !/process/logout\.php$ [NC]
    RewriteCond %{REQUEST_URI} !/process/update-status-pesanan\.php$ [NC]
    RewriteRule ^process/ - [F]
</IfModule>